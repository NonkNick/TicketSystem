{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write resources/ && eslint . --fix",
        "format:check": "prettier --check resources/**/*.{css,ts,js} && eslint .",
        "type-check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.4",
        "eslint-plugin-better-tailwindcss": "^4.6.1",
        "eslint-plugin-vue": "^10.9.2",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.4",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.6"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "lucide-vue-next": "^1.0.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.38",
        "vue-router": "^5.1.0"
    }
}
